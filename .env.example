# ─────────────────────────────────────────────────────────────
# home-voice-safety-layer 配置模板
# 复制为 .env 后按机器情况填写；决策层不依赖任何一项即可运行。
# ─────────────────────────────────────────────────────────────

# ===== 核心（决策与安全层）=====
# 审计日志与幂等键的 SQLite 位置（相对路径按仓库根解析）
HVSL_DB_PATH=var/decisions.db
# 风险策略（危险动作白名单）。改这个文件=改安全边界，要走评审
HVSL_POLICY_PATH=hvsl/policy/risk_policy.json
# 已评审的设备清单：danger:* 标签与真实/模拟标注的唯一来源
HVSL_DEVICE_CATALOG=devices/devices.json

# F-007 危险动作确认有效期（秒）。调小=更容易因为来不及确认而作废
HVSL_CONFIRM_TTL_SECONDS=120
# F-008 幂等去重窗口（秒）。调小=重复指令更容易重复下发
HVSL_DEDUP_WINDOW_SECONDS=30
# 下发结果未知时的保守判定（秒）
HVSL_IN_FLIGHT_STALE_SECONDS=120
# P2-2 审计保留天数（0=永久；failed_unknown/in_flight_unknown 证据永不清理）
HVSL_AUDIT_RETENTION_DAYS=30
# R12 是否把用户原句写入 audit.utterance：1=保留（默认），0/false/no=写 [redacted]
# 关闭后 trace/risk/targets 仍保留，仅原句脱敏；第一版仍建议依赖 OS 全盘加密
HVSL_STORE_UTTERANCE=1
# F-006 单次服务调用超时（秒）
HVSL_DISPATCH_TIMEOUT_SECONDS=8

# ===== 意图解析 =====
# rule = 离线确定性解析（默认，评测与测试都用它）；llm = 本地 Ollama，失败自动降级回 rule
HVSL_NLU_PROVIDER=rule
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
HVSL_NLU_TIMEOUT_SECONDS=12
# 隐私开关：默认 false。设成 true 前请想清楚：文本出机器就出了家庭行为数据
HVSL_ALLOW_CLOUD_LLM=false

# ===== 本地 HTTP 接口（python -m hvsl.cli serve）=====
# 只听 127.0.0.1；填别的地址会被拒绝启动（隐私边界 F-010）
HVSL_SERVER_HOST=127.0.0.1
HVSL_SERVER_PORT=8777

# ===== Home Assistant 后端（不填则用内置模拟实体，可完全离线跑通）=====
# HA_BASE_URL=http://127.0.0.1:8123
# HA_TOKEN=【填：HA 长期访问令牌】
# 真实设备 entity_id（逗号分隔）；未列出的按“模拟”标注（F-003 真实/模拟清单）
# HA_REAL_ENTITIES=【填：可联调的真实设备 entity_id，没有就留空】

# ===== 本地 ASR（F-004）=====
# 指向装有 faster-whisper 的 venv；留空则用当前解释器（需 pip install faster-whisper）
ASR_PYTHON_BIN=【填：装有 faster-whisper 的 python 路径，例如 D:/asr/.venv/Scripts/python.exe】
# 模型权重目录（放 D 盘）。local_files_only=True，不会联网下载
ASR_MODEL_DIR=【填：faster-whisper large-v3 的 snapshots 目录】
ASR_MODEL_SIZE=large-v3
ASR_DEVICE=cuda

# ===== 本地 TTS（F-005）=====
# 合成结果落盘到 WAV；只有 `hvsl say --loud` 才会外放声音
TTS_WAV_OUT=var/tts_last.wav
